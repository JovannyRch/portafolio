---
import { site } from '../data/site';

const pathname = Astro.url.pathname;
---

<header class="site-header">
	<div class="shell header-inner">
		<a class="brand" href="/">
			<span class="brand-mark">JR</span>
			<span class="brand-copy">
				<strong>{site.name}</strong>
				<span>{site.role}</span>
			</span>
		</a>
		<nav class="site-nav" aria-label="Primary">
			{
				site.navigation.map((item) => (
					<a class:list={['nav-link', pathname === item.href && 'is-active']} href={item.href} data-copy-es={item.labelEs} data-copy-en={item.labelEn}>
						{item.label}
					</a>
				))
			}
		</nav>
		<div class="header-controls">
			<button class="language-toggle" type="button" data-language-toggle aria-label="Cambiar idioma a inglés">
				<span data-language-label>ES</span>
				<svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
			</button>
		</div>
	</div>
</header>
