---
import '../styles/global.css';
import '../styles/inner-pages.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = site.title,
	description = site.description,
} = Astro.props;

const ogImage = '/favicon.svg';
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#111315" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<title>{title}</title>
		<script is:inline>
			(() => {
				const root = document.documentElement;
				root.classList.add('js');
				const storedLanguage = localStorage.getItem('language');
				const language = storedLanguage || (navigator.languages?.some((item) => item.toLowerCase().startsWith('es')) ? 'es' : 'en');
				root.lang = language;
				root.dataset.language = language;
			})();
		</script>
	</head>
	<body>
		<SiteHeader />
		<slot />
		<SiteFooter />
		<script is:inline>
			(() => {
				const root = document.documentElement;
				const syncLanguageUI = () => {
					const language = root.dataset.language || 'es';
					document.querySelectorAll('[data-copy-es][data-copy-en]').forEach((node) => {
						node.textContent = node.getAttribute(`data-copy-${language}`) || '';
					});
					document.querySelectorAll('[data-language-label]').forEach((node) => {
						node.textContent = language.toUpperCase();
					});
					document.querySelectorAll('[data-language-toggle]').forEach((button) => {
						button.setAttribute('aria-label', language === 'es' ? 'Cambiar idioma a inglés' : 'Switch language to Spanish');
					});
				};

				const bindLanguageToggle = () => {
					document.querySelectorAll('[data-language-toggle]').forEach((button) => {
						if (button.dataset.bound === 'true') return;
						button.dataset.bound = 'true';
						button.addEventListener('click', () => {
							const language = root.dataset.language === 'es' ? 'en' : 'es';
							root.dataset.language = language;
							root.lang = language;
							localStorage.setItem('language', language);
							syncLanguageUI();
							window.dispatchEvent(new CustomEvent('languagechange', { detail: { language } }));
						});
					});
					syncLanguageUI();
				};

				const bindScrollReveal = () => {
					if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

					const targets = document.querySelectorAll(
						'.section-intro, .content-section, .timeline-item, .project-card, .app-card, .skill-card, .detail-card, .visual-placeholder, .metric-card, .achievement-item, .hero-surface, .hero-aside',
					);

					if (!targets.length) return;

					const observer = new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								if (entry.isIntersecting) {
									entry.target.classList.add('is-visible');
									observer.unobserve(entry.target);
								}
							});
						},
						{ rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
					);

					targets.forEach((target) => {
						if (target.classList.contains('is-visible')) return;
						target.classList.add('reveal-on-scroll');
						observer.observe(target);
					});
				};

				const initUIEnhancements = () => {
					bindLanguageToggle();
					bindScrollReveal();
				};

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initUIEnhancements, { once: true });
				} else {
					initUIEnhancements();
				}

				document.addEventListener('astro:page-load', initUIEnhancements);
			})();
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
