---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { heroHighlights, keyAchievements, metrics, publishedApps, skillGroups } from '../data/profile';
import { site } from '../data/site';
import ProjectCard from '../components/ProjectCard.astro';
import '../styles/home-refresh.css';

const featuredProjects = (await getCollection('projects', ({ data }) => data.featured)).sort(
	(a, b) => a.data.title.localeCompare(b.data.title),
);

const es = {
	metrics: [
		'descargas en aplicaciones móviles publicadas',
		'años construyendo sistemas web y móviles en producción',
		'trayectoria senior de ingeniería en Enapsys',
	],
	achievements: [
		'Construí aplicaciones móviles con más de 350K descargas',
		'Lideré el desarrollo de aplicaciones empresariales',
		'Diseñé sistemas backend escalables con funciones en tiempo real',
		'Publiqué aplicaciones en entornos de producción',
		'Coescribí un artículo de investigación publicado por INIFAP vinculado a una aplicación móvil',
		'Mentoré a desarrolladores junior',
	],
	projectDescriptions: {
		ahuacatl: 'Aplicación móvil para analizar la distribución espacial de problemas fitosanitarios en cultivos de aguacate, respaldada por una publicación de INIFAP.',
		netcurio: 'Plataforma financiera empresarial enfocada en frontend y backend escalables para procesos de negocio complejos.',
		'shopify-estafeta': 'Integración entre tiendas Shopify y flujos de envío que reduce el trabajo operativo manual.',
		'truth-tables': 'Aplicación móvil educativa que hace más rápidos y accesibles los procesos de lógica para estudiantes y usuarios técnicos.',
	} as Record<string, string>,
	apps: [
		{
			purpose: 'Creada para que estudiantes y usuarios técnicos generen y validen tablas de verdad rápidamente desde una herramienta móvil.',
			impact: 'Alcanzó a cientos de miles de usuarios y se convirtió en una aplicación educativa ampliamente utilizada.',
		},
		{
			purpose: 'Creada para simplificar la resolución de mapas de Karnaugh y hacer más accesible el estudio de lógica digital.',
			impact: 'Logró una adopción relevante dentro de un nicho educativo especializado.',
		},
	],
	skills: [
		{ title: 'Principal', description: 'Tecnologías principales para construir sistemas móviles, frontend y backend en producción.' },
		{ title: 'Arquitectura y backend', description: 'Diseño de sistemas e integraciones para productos escalables.' },
		{ title: 'Otras herramientas', description: 'Tecnologías complementarias para entrega, despliegue y frontend moderno.' },
	],
};
---

<Layout title={site.title} description={site.description}>
	<main class="home-refresh">
		<section class="refresh-hero" aria-labelledby="hero-title">
			<div class="refresh-hero-inner">
				<div class="identity-mark" aria-hidden="true">
					<span>JR</span>
					<i></i>
				</div>

				<div class="refresh-hero-copy">
					<p class="refresh-intro"><span data-copy-es="Hola, soy" data-copy-en="Hi, I’m">Hola, soy</span> <strong>{site.name}</strong>,</p>
					<h1 id="hero-title">
						<span>Senior Fullstack &amp; Mobile Engineer</span>
						<strong class="hero-statement" data-copy-es="que convierte ideas complejas en productos que escalan." data-copy-en="turning complex ideas into products that scale.">que convierte ideas complejas en productos que escalan.</strong>
					</h1>
					<p class="refresh-lede" data-copy-es="Construyo aplicaciones móviles, plataformas web y sistemas backend de producción, desde la arquitectura hasta el lanzamiento." data-copy-en="I build production mobile apps, web platforms, and backend systems—from architecture to launch.">Construyo aplicaciones móviles, plataformas web y sistemas backend de producción, desde la arquitectura hasta el lanzamiento.</p>
					<div class="refresh-chips" aria-label="Especialidades">
						<span>Mobile</span>
						<span>Fullstack</span>
						<span>System Design</span>
						<span data-copy-es="Desde México" data-copy-en="Based in Mexico">Desde México</span>
					</div>
					<div class="refresh-actions">
						<a href="#selected-work"><span data-copy-es="Ver mi trabajo" data-copy-en="See my work">Ver mi trabajo</span> <span aria-hidden="true">↘</span></a>
						<a href={`mailto:${site.email}`}><span data-copy-es="Hablemos" data-copy-en="Let’s talk">Hablemos</span> <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</div>

			<div class="proof-strip" aria-label="Resultados destacados">
				{metrics.map((metric, index) => (
					<article>
						<span class="proof-index">0{index + 1}</span>
						<strong>{metric.value}</strong>
						<p data-copy-es={es.metrics[index]} data-copy-en={metric.label}>{es.metrics[index]}</p>
					</article>
				))}
			</div>
		</section>

		<div class="shell page-stack refresh-content">

		<section class="achievement-band">
			<div class="section-head compact">
				<p class="section-kicker" data-copy-es="Logros clave" data-copy-en="Key Achievements">Logros clave</p>
				<h2 data-copy-es="Resultados reales en escala, liderazgo y entregas a producción." data-copy-en="Selected proof points across scale, leadership, and production delivery.">Resultados reales en escala, liderazgo y entregas a producción.</h2>
			</div>
			<div class="achievements-list">
				{keyAchievements.map((item, index) => <article class="achievement-item"><p data-copy-es={es.achievements[index]} data-copy-en={item}>{es.achievements[index]}</p></article>)}
			</div>
		</section>

		<section class="content-section" id="selected-work">
			<div class="section-head">
				<p class="section-kicker" data-copy-es="Proyectos destacados" data-copy-en="Featured Projects">Proyectos destacados</p>
				<h2 data-copy-es="Sistemas reales: productos móviles, plataformas empresariales e integraciones." data-copy-en="Real systems across enterprise delivery, mobile products, and integrations.">Sistemas reales: productos móviles, plataformas empresariales e integraciones.</h2>
				<p class="section-copy" data-copy-es="Casos de estudio que muestran las decisiones, la ejecución técnica y el impacto de cada producto." data-copy-en="Case studies showing the decisions, technical execution, and impact behind each product.">Casos de estudio que muestran las decisiones, la ejecución técnica y el impacto de cada producto.</p>
			</div>
			<div class="project-grid">
				{featuredProjects.slice(0, 6).map((project) => <ProjectCard project={project} descriptionEs={es.projectDescriptions[project.id]} />)}
			</div>
		</section>

		<section class="content-section">
			<div class="section-head">
				<p class="section-kicker" data-copy-es="Aplicaciones publicadas" data-copy-en="Published Mobile Apps">Aplicaciones publicadas</p>
				<h2 data-copy-es="Aplicaciones educativas construidas y publicadas para cientos de miles de usuarios." data-copy-en="Built and published educational apps used by hundreds of thousands of users.">Aplicaciones educativas construidas y publicadas para cientos de miles de usuarios.</h2>
			</div>
			<div class="apps-grid">
				{
					publishedApps.map((app, index) => (
						<article class="app-card">
							<div class="app-card-top">
								<div>
									<p class="project-label" data-copy-es="Aplicación publicada" data-copy-en="Published App">Aplicación publicada</p>
									<h3>{app.name}</h3>
								</div>
								<p class="app-downloads">{app.downloads}</p>
							</div>
							<p data-copy-es={es.apps[index].purpose} data-copy-en={app.purpose}>{es.apps[index].purpose}</p>
							<p data-copy-es={es.apps[index].impact} data-copy-en={app.impact}>{es.apps[index].impact}</p>
							<p class="app-tech">{app.tech}</p>
							<a class="button button-secondary app-link" href={app.link} target="_blank" rel="noreferrer">
								<span data-copy-es="Ver en Play Store" data-copy-en="View on Play Store">Ver en Play Store</span>
							</a>
						</article>
					))
				}
			</div>
		</section>

		<section class="content-section">
			<div class="section-head">
				<p class="section-kicker" data-copy-es="Competencias" data-copy-en="Skills">Competencias</p>
				<h2 data-copy-es="Fortalezas en ingeniería móvil, sistemas frontend y arquitectura backend." data-copy-en="Clear strengths across mobile engineering, frontend systems, and backend architecture.">Fortalezas en ingeniería móvil, sistemas frontend y arquitectura backend.</h2>
			</div>
			<div class="skills-grid">
				{
					skillGroups.map((group, index) => (
						<article class="skill-card">
							<p class="skill-title" data-copy-es={es.skills[index].title} data-copy-en={group.title}>{es.skills[index].title}</p>
							<p class="skill-copy" data-copy-es={es.skills[index].description} data-copy-en={group.description}>{es.skills[index].description}</p>
							<div class="skill-list">
								{group.items.map((item) => <span class="skill-chip">{item}</span>)}
							</div>
						</article>
					))
				}
			</div>
		</section>
		</div>
	</main>
</Layout>
