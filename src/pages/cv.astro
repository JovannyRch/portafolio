---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { experience, keyAchievements, skillGroups } from '../data/profile';
import { experienceEs, keyAchievementsEs, projectDescriptionsEs, skillTitlesEs } from '../data/i18n';

const projects = (await getCollection('projects')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="CV | Jovanny Ramírez" description="Professional profile and experience summary for Jovanny Ramírez.">
	<main class="shell page-stack inner-page cv-page">
		<SectionIntro
			kicker="CV"
			kickerEs="CV"
			title="Senior Fullstack & Mobile Engineer with experience across product, architecture, and delivery."
			titleEs="Senior Fullstack & Mobile Engineer con experiencia en producto, arquitectura y entrega."
			copy="Web version of the resume with a concise summary of experience, skills, and selected projects."
			copyEs="Versión web del currículum con experiencia, competencias y proyectos seleccionados."
		/>

		<section class="content-section">
			<div class="cv-header">
				<div class="section-head compact">
					<p class="section-kicker" data-copy-es="Resumen" data-copy-en="Summary">Resumen</p>
					<p class="section-copy" data-copy-es="Ingeniero senior fullstack y móvil con experiencia construyendo aplicaciones en producción con Flutter, React, Node.js y arquitectura backend. Experiencia sólida en sistemas empresariales, APIs, microservicios, tiempo real y productos digitales con adopción a escala." data-copy-en="Senior Fullstack and Mobile Engineer with experience building production-grade applications across Flutter, React, Node.js, and backend architecture. Strong background in enterprise systems, APIs, microservices, real-time features, and digital products with large user adoption.">Ingeniero senior fullstack y móvil con experiencia construyendo aplicaciones en producción con Flutter, React, Node.js y arquitectura backend.</p>
				</div>
				<a class="button button-primary" href="/jovanny-ramirez-cv.pdf" download>
					<span data-copy-es="Descargar PDF" data-copy-en="Download PDF">Descargar PDF</span>
					<svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18">
						<path d="M10 3v9m0 0 3.5-3.5M10 12 6.5 8.5M4 16h12" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
			</div>
		</section>

		<section class="content-section">
			<div class="section-head compact">
				<p class="section-kicker" data-copy-es="Logros" data-copy-en="Highlights">Logros</p>
			</div>
			<div class="achievements-list">
				{keyAchievements.map((item, index) => <article class="achievement-item"><p data-copy-es={keyAchievementsEs[index]} data-copy-en={item}>{keyAchievementsEs[index]}</p></article>)}
			</div>
		</section>

		<section class="content-section">
			<div class="section-head compact">
				<p class="section-kicker" data-copy-es="Experiencia" data-copy-en="Experience">Experiencia</p>
			</div>
			<section class="timeline-list">
				{
					experience.map((job, index) => (
						<article class="timeline-item">
							<div class="timeline-meta">
								<p class="timeline-period">{job.period}</p>
								<p class="timeline-company">{job.company}</p>
							</div>
							<div class="timeline-content">
								<h2>{job.role}</h2>
								<p class="timeline-summary" data-copy-es={experienceEs[index].summary} data-copy-en={job.summary}>{experienceEs[index].summary}</p>
								<ul>
									{job.points.map((point, pointIndex) => <li data-copy-es={experienceEs[index].points[pointIndex]} data-copy-en={point}>{experienceEs[index].points[pointIndex]}</li>)}
								</ul>
							</div>
						</article>
					))
				}
			</section>
		</section>

		<section class="content-section">
			<div class="section-head compact">
				<p class="section-kicker" data-copy-es="Competencias" data-copy-en="Skills">Competencias</p>
			</div>
			<div class="skills-grid">
				{
					skillGroups.map((group, index) => (
						<article class="skill-card">
							<p class="skill-title" data-copy-es={skillTitlesEs[index]} data-copy-en={group.title}>{skillTitlesEs[index]}</p>
							<div class="skill-list">
								{group.items.map((item) => <span class="skill-chip">{item}</span>)}
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="content-section">
			<div class="section-head compact">
				<p class="section-kicker" data-copy-es="Proyectos" data-copy-en="Projects">Proyectos</p>
			</div>
			<div class="project-grid">
				{
					projects.map((project) => (
						<article class="project-card">
							<div class="project-card-head">
								<p class="project-category">{project.data.category}</p>
								{project.data.metrics.downloads && (
									<p class="project-role">{project.data.metrics.downloads}</p>
								)}
							</div>
							<h3 class="project-title">
								<a href={`/projects/${project.id}`}>{project.data.title}</a>
							</h3>
							<p class="project-summary" data-copy-es={projectDescriptionsEs[project.id]} data-copy-en={project.data.description}>{projectDescriptionsEs[project.id]}</p>
							<ul class="project-tech-list">
								{project.data.techStack.map((item) => <li>{item}</li>)}
							</ul>
						</article>
					))
				}
			</div>
		</section>
	</main>
</Layout>
