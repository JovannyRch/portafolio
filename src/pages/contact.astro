---
import Layout from '../layouts/Layout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { site } from '../data/site';
---

<Layout title="Contact | Jovanny Ramírez" description="Contact Jovanny Ramírez for senior fullstack and mobile engineering opportunities.">
	<main class="shell page-stack inner-page contact-page">
		<SectionIntro
			kicker="Contact"
			kickerEs="Contacto"
			title="I'm open to remote opportunities and collaborations."
			titleEs="Estoy disponible para oportunidades remotas y colaboraciones."
			copy="Minimal, direct contact details for senior engineering roles, freelance opportunities, and product-focused collaborations."
			copyEs="Contacto directo para posiciones senior, proyectos freelance y colaboraciones enfocadas en producto."
		/>

		<section class="contact-page-grid">
			<article class="contact-intro-card">
				<p class="project-label" data-copy-es="Disponibilidad" data-copy-en="Availability">Disponibilidad</p>
				<p class="contact-lede" data-copy-es="Estoy disponible para oportunidades remotas y colaboraciones." data-copy-en="I’m open to remote opportunities and collaborations.">Estoy disponible para oportunidades remotas y colaboraciones.</p>
				<p class="contact-support" data-copy-es={`Desde ${site.location}, enfocado en productos móviles, arquitectura backend, APIs escalables y sistemas en tiempo real.`} data-copy-en={`Based in ${site.location}, focused on mobile products, backend architecture, scalable APIs, and real-time systems.`}>Desde {site.location}, enfocado en productos móviles, arquitectura backend, APIs escalables y sistemas en tiempo real.</p>
			</article>

			<div class="contact-grid">
				<article class="detail-card contact-card-item">
					<p class="project-label" data-copy-es="Correo" data-copy-en="Email">Correo</p>
					<p><a href={`mailto:${site.email}`}>{site.email}</a></p>
				</article>
				<article class="detail-card contact-card-item">
					<p class="project-label">GitHub</p>
					<p><a href={site.github} target="_blank" rel="noreferrer">github.com/jovannyrch</a></p>
				</article>
				<article class="detail-card contact-card-item">
					<p class="project-label">LinkedIn</p>
					<p>
						{site.linkedin ? (
							<a href={site.linkedin} target="_blank" rel="noreferrer">linkedin.com/in/jovannyrch</a>
						) : (
							<span data-copy-es="URL del perfil pendiente" data-copy-en="Profile URL pending">URL del perfil pendiente</span>
						)}
					</p>
				</article>
			</div>
		</section>
	</main>
</Layout>
