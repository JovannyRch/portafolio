---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionIntro from '../../components/SectionIntro.astro';
import { projectDescriptionsEs } from '../../data/i18n';

const projects = (await getCollection('projects')).sort((a, b) => {
	if (a.data.category === b.data.category) return a.data.title.localeCompare(b.data.title);
	return a.data.category.localeCompare(b.data.category);
});
const filters = [
	{ label: 'All', labelEs: 'Todos', value: 'all' },
	{ label: 'Mobile', labelEs: 'Móvil', value: 'mobile' },
	{ label: 'Backend', labelEs: 'Backend', value: 'backend' },
	{ label: 'Enterprise', labelEs: 'Empresarial', value: 'enterprise' },
];
---

<Layout title="Projects | Jovanny Ramírez" description="Selected projects across enterprise systems, mobile products, and integrations.">
	<main class="shell page-stack inner-page projects-page">
		<SectionIntro
			kicker="Projects"
			kickerEs="Proyectos"
			title="Selected work across enterprise systems, mobile products, and integrations."
			titleEs="Trabajo seleccionado en sistemas empresariales, productos móviles e integraciones."
			copy="Project entries are powered by Astro content collections for a clean, scalable case-study structure."
			copyEs="Casos de estudio estructurados para mostrar decisiones técnicas, ejecución e impacto."
		/>

		<section class="content-section">
			<div class="projects-toolbar">
				<div class="filter-list" role="tablist" aria-label="Project categories">
					{
						filters.map((filter, index) => (
							<button
								type="button"
								class:list={['filter-chip', index === 0 && 'is-active']}
								data-filter={filter.value}
								role="tab"
								aria-selected={index === 0 ? 'true' : 'false'}
							>
								<span data-copy-es={filter.labelEs} data-copy-en={filter.label}>{filter.labelEs}</span>
							</button>
						))
					}
				</div>
				<p class="projects-count" data-project-count data-count={projects.length}>{projects.length} proyectos</p>
			</div>

			<div class="project-grid" data-project-grid>
				{
					projects.map((project) => (
						<div data-project-item data-category={project.data.category}>
							<ProjectCard project={project} descriptionEs={projectDescriptionsEs[project.id]} />
						</div>
					))
				}
			</div>
		</section>
	</main>
</Layout>

<script is:inline>
	const initProjectsFilter = () => {
		const filterButtons = Array.from(document.querySelectorAll('[data-filter]'));
		const projectItems = Array.from(document.querySelectorAll('[data-project-item]'));
		const countNode = document.querySelector('[data-project-count]');

		if (!filterButtons.length || !projectItems.length) return;

		const updateProjects = (activeFilter) => {
			let visibleCount = 0;

			projectItems.forEach((item) => {
				const matches = activeFilter === 'all' || item.dataset.category === activeFilter;
				item.hidden = !matches;
				if (matches) visibleCount += 1;
			});

			if (countNode) {
			const language = document.documentElement.dataset.language || 'es';
			countNode.textContent = language === 'es'
				? `${visibleCount} proyecto${visibleCount === 1 ? '' : 's'}`
				: `${visibleCount} project${visibleCount === 1 ? '' : 's'}`;
			}
		};

		filterButtons.forEach((button) => {
			if (button.dataset.bound === 'true') return;
			button.dataset.bound = 'true';

			button.addEventListener('click', () => {
				const activeFilter = button.dataset.filter ?? 'all';

				filterButtons.forEach((candidate) => {
					const isActive = candidate === button;
					candidate.classList.toggle('is-active', isActive);
					candidate.setAttribute('aria-selected', isActive ? 'true' : 'false');
				});

				updateProjects(activeFilter);
			});
		});

		updateProjects('all');

		if (document.documentElement.dataset.projectLanguageBound !== 'true') {
			document.documentElement.dataset.projectLanguageBound = 'true';
			window.addEventListener('languagechange', () => {
				const activeButton = filterButtons.find((button) => button.classList.contains('is-active'));
				updateProjects(activeButton?.dataset.filter ?? 'all');
			});
		}
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProjectsFilter, { once: true });
	} else {
		initProjectsFilter();
	}

	document.addEventListener('astro:page-load', initProjectsFilter);
</script>
